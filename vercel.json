{
  "redirects": [
    { "source": "/reset-password", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/transdata/:caminho*", "destination": "https://projetostransdata.vercel.app/transdata/:caminho*" },
    { "source": "/transmobile/:caminho*", "destination": "https://transmobile.vercel.app/transmobile/:caminho*" },
    { "source": "/roadmap/:caminho*", "destination": "https://roadmap-de-evolucao.vercel.app/roadmap/:caminho*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
